# ---------------------------------------------------------------------------
# Uplift — environment template
#
# Copy to `.env` (git-ignored) and fill in the values you need.
#   cp .env.example .env
#
# NOTE: these are NOT read by the Cloudflare Worker in production. For
# deployment, set secrets with `wrangler secret put <NAME>` instead:
#   cd server && npx wrangler secret put GROQ_API_KEY
#
# This file is used by local tooling and documents every variable the app
# understands.
# ---------------------------------------------------------------------------

# --- AI (required for AI features) -----------------------------------------
# Groq API key — powers positivity classification, the daily digest intro and
# the "why this story" deep dives. Free tier: https://console.groq.com
# Without this the Worker falls back to a heuristic classifier.
GROQ_API_KEY=

# --- Telegram (optional) ---------------------------------------------------
# Bot token from @BotFather. Used to send Circle notifications.
TG_BOT_TOKEN=

# Shared secret Telegram sends as `X-Telegram-Bot-Api-Secret-Token`.
# MUST match the value set via Telegram's setWebhook(secret_token=...).
# Generate with:  openssl rand -hex 32
TG_WEBHOOK_SECRET=

# --- X / Twitter (optional) ------------------------------------------------
# Used by the Creators Circle sync job.
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CREATORS_LIST_ID=

# --- Sessions --------------------------------------------------------------
# Long random string used to sign session material.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# --- Web Push (optional) ---------------------------------------------------
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- CORS / networking -----------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional comma-separated allowlist for the image proxy. When set, only
# images from these domains can be proxied through /api/image-proxy.
# IMAGE_PROXY_ALLOWED_DOMAINS=i.redd.it,preview.redd.it,dev-to-uploads.s3.amazonaws.com

# ---------------------------------------------------------------------------
# Unused by the current code — kept because they were present in an earlier
# `.env`. The Worker uses GROQ_API_KEY for AI, not these.
# Remove them (and rotate the keys) if they are no longer needed.
# ---------------------------------------------------------------------------
# LLAMA_API_KEY=
# MISTRAL_LARGE_API_KEY=
