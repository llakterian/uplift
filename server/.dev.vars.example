# ---------------------------------------------------------------------------
# Uplift Worker — local development secrets
#
# Copy to `.dev.vars` (git-ignored) and fill in real values:
#   cp .dev.vars.example .dev.vars
#
# `.dev.vars` is read by `wrangler dev` and is never deployed.
# ---------------------------------------------------------------------------

# REQUIRED — AI features (positivity classification, daily digest intro,
# "why this story" deep dives). Get a free key at https://console.groq.com
# Without it the Worker falls back to a heuristic classifier.
GROQ_API_KEY=

# REQUIRED for session authentication — a long random string.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# REQUIRED for the Telegram bot to accept webhook updates.
# Must match the secret set via Telegram's setWebhook(secret_token=...).
# Generate with:  openssl rand -hex 32
TG_WEBHOOK_SECRET=

# OPTIONAL — Telegram bot token (from @BotFather).
# Enables sending Circle notifications to subscribers.
TG_BOT_TOKEN=

# OPTIONAL — X (Twitter) API credentials, used by the Creators Circle sync.
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CREATORS_LIST_ID=

# OPTIONAL — Web Push (VAPID) keys for browser notifications.
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# OPTIONAL — comma-separated browser origins allowed to call the API.
# Defaults to the built-in list when unset.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OPTIONAL — comma-separated allowlist for the image proxy.
# When set, only images from these domains can be proxied.
# IMAGE_PROXY_ALLOWED_DOMAINS=i.redd.it,preview.redd.it,dev-to-uploads.s3.amazonaws.com
